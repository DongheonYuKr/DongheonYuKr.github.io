<p class="meta"><span class="kicker">무료 도구</span> <span class="trial">시제품</span></p>
<h1>이 깃허브 도구, <span class="mark">나도 깔 수 있을까?</span></h1>
<p class="lead">깃허브 주소를 넣으면, 개발 모르는 사람이 AI한테 시켜 직접 깔아 본 기록에서 찾아 준비물·난이도·함정을 보여 드립니다. 아직 깔아 보지 않은 도구는 지어내서 판정하지 않고, 깔기 전에 확인할 것만 알려 드립니다.</p>
<p class="notice"><strong>참고용 · 결과 보장 없음</strong> · 같은 도구라도 컴퓨터·버전에 따라 결과가 다를 수 있습니다. 깔지 말지는 직접 정하세요. 입력한 주소는 이 화면 안에서만 찾고 어디에도 저장·전송하지 않습니다(쿠키 없음).</p>

<noscript><p class="notice">이 판정은 자바스크립트가 켜져 있어야 움직입니다. 아래 「깔아 본 도구」 표에서 직접 보실 수 있습니다.</p></noscript>

<form class="calc" id="chk" aria-describedby="chk-help">
<fieldset>
<legend><label for="url">깃허브 주소</label></legend>
<div class="row"><input id="url" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://github.com/만든사람/도구이름" style="flex:1 1 280px"><button type="submit">판정 보기</button></div>
<p id="chk-help" class="src">예) github.com/tt-a1i/archify · 주소 대신 「만든사람/도구이름」만 넣어도 됩니다.</p>
</fieldset>
</form>

<div id="out" aria-live="polite"></div>

<h2>깔아 본 도구</h2>
<p class="legend">난이도: ⭐ 클릭만 · ⭐⭐ 따라 하면 됨 · ⭐⭐⭐ 터미널 필요 · 💀 포기</p>
<div class="tablewrap"><table class="chkt">
<thead><tr><th scope="col">도구</th><th scope="col">난이도</th><th scope="col">깔아 본 날 · 지금 쓰나</th></tr></thead>
<tbody id="rows"></tbody>
</table></div>

<aside class="cta tiers" aria-label="더 해 보고 싶다면"><p><strong>판정 말고, 똑같이 깔아 보고 싶다면</strong></p>
<ul>
<li><b>깃허브 털기 정리본 · 3,900원</b> — AI에게 실제로 붙여 넣은 문장과 막혔을 때 물은 문장을 회차별로 묶고 있습니다. 2026년 11월 8일 판매 시작 예정이며, 시작하면 이 자리에 링크를 붙입니다.</li>
</ul>
<p>다음 회차는 인스타그램 <a href="https://www.instagram.com/heonlog.studio/" rel="noopener">@heonlog.studio</a>에 먼저 올라옵니다.</p></aside>

<script>
(function(){
  // 직접 깔아 본 기록만 (사실 근거: 깔아 본 기록 파일 · 2026-11-01 기준). 다음 후보·안 깔아 본 도구는 넣지 않음.
  var T = [
    {n:"archify", r:"tt-a1i/archify", d:"2026-10-30", lv:"⭐⭐⭐", g:"github-archify",
     what:"생각·계획·코드를 그림 한 장(웹페이지)으로 그려 주는 AI 스킬",
     need:["클로드 코드 같은 클로드(터미널)","원본을 내려받아 스킬 폴더에 복사"],
     why:"클로드가 터미널에서 원본을 내려받아 안을 먼저 확인하고 스킬 폴더에 복사함 · 사람이 혼자 깔아 본 난이도는 미확인",
     trap:["하루 한 번 깃허브에 새 버전을 확인하는 기능이 켜져 있어서 껐음","「한 장짜리 설명 페이지」 모드는 컴퓨터 전체 AI 설정 파일에 한 줄을 써 넣는 기능이라 켜지 않았음","첫 그림은 휴대폰에서 옆으로 밀어서 봐야 했음"],
     use:"씀 — 설명이 길어지는 일·업무 흐름을 그림 한 장으로"},
    {n:"Agent Reach", r:"Panniantong/Agent-Reach", d:"2026-10-30", lv:"⭐⭐⭐", g:"github-agent-reach",
     what:"클로드가 유튜브 자막·웹페이지·깃허브를 읽어 오게 하는 도구",
     need:["클로드 코드 같은 클로드(터미널)","설치 명령 한 줄을 사람이 직접 붙여 넣기"],
     why:"터미널(클로드 코드 입력창)에 명령 한 줄을 붙여 넣어 깔았음",
     trap:["클로드가 먼저 깔려고 했는데, 밖에서 받은 코드를 실행하는 일이라 보안 장치가 막았음 → 사람이 직접 붙여 넣었음","레딧 검색이 안 됐음(원인 미확인) · 시험한 기능 17개 중 13개만 작동","X·인스타·페이스북 로그인 기능은 계정이 제한될 위험이 있어 켜지 않았음"],
     use:"씀 — 유튜브 자막·웹·깃허브 읽기만 (로그인 연결 안 함)"},
    {n:"VoiceStudio", r:"debpalash/VoiceStudio", d:"2026-10-31", lv:"💀", g:"github-voicestudio",
     what:"맥 안에서 돌리는 AI 목소리 복제·더빙 앱 (유료 AI 목소리 서비스 대신)",
     need:["앱 내려받기","복제할 목소리 녹음(시험 때 18초)"],
     why:"앱을 내려받아 깔았지만 결과물이 써먹을 수준이 아니라 포기",
     trap:["고른 모델 중 일부는 목소리 복제가 안 된다고 나왔음","복제는 됐지만 목소리가 어색하게 나왔음","코드 공개 조건이 있는 라이선스(AGPL-3.0)"],
     use:"안 씀 — 지움"},
    {n:"hyperframes", r:"heygen-com/hyperframes", d:"2026-11-01", lv:"⭐⭐⭐", g:"github-hyperframes",
     what:"웹페이지(HTML)를 쓰듯 영상을 만드는 AI 스킬 묶음",
     need:["클로드 코드 같은 클로드(터미널)","npx 명령 한 줄"],
     why:"터미널(클로드 코드 입력창)에 npx 명령 한 줄을 붙여 넣어 깔았음",
     trap:["깔고 나니 「AI와 같은 권한으로 움직여요」 안내가 나옴 → 깔린 파일을 먼저 훑어봄","목소리·아바타·클라우드 렌더는 HeyGen 유료 키가 있어야 움직임 → 키 없이 맥 안 무료 렌더만 씀","설치 화면 보안 검사에서 1개가 Med Risk 표시"],
     use:"씀 — 릴스 만들기(유료 키 없이)"},
    {n:"taste-skill", r:"Leonxlnx/taste-skill", d:"2026-11-01", lv:"⭐⭐⭐", g:"github-taste-skill",
     what:"AI가 만드는 웹페이지가 뻔해 보이지 않게 디자인을 점검하는 스킬",
     need:["클로드 코드 같은 클로드(터미널)","npx 명령 한 줄"],
     why:"터미널에 npx 명령 한 줄",
     trap:["명령 두 개를 한 줄로 이어 붙였더니 앞 명령만 실행됐음 → 남은 것을 따로 다시 실행","설치 화면 보안 검사에서 Med Risk 표시 → 공개 사진 사이트에만 접속하는 것을 확인함","컴퓨터 전체가 아니라 그때 연 작업 폴더 하나에만 깔렸음"],
     use:"씀 — 페이지 만들 때 디자인 점검"},
    {n:"ponytail", r:"DietrichGebert/ponytail", d:"2026-11-01", lv:"⭐⭐⭐", g:"",
     what:"AI가 코드를 덜 짜고 이미 있는 것부터 쓰게 하는 규칙 플러그인",
     need:["클로드 코드(터미널)","명령 두 줄(마켓 추가 → 플러그인 설치)"],
     why:"터미널에 명령 두 줄(마켓 추가 → 플러그인 설치)",
     trap:["설치 뒤 「설정 4개를 아직 안 정했다」는 안내가 나옴 → 기본값 그대로 둠","새 대화를 열 때마다 자동으로 붙는 장치라, 밖으로 보내는 칸(webhook)이 비어 있는지 먼저 확인함"],
     use:"씀 — 앱 개발할 때(효과는 아직 확인 전)"}
  ];
  function $(id){ return document.getElementById(id); }
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]; }); }
  function key(v){
    v = String(v || "").trim().toLowerCase();
    v = v.replace(/^[a-z]+:\/\//, "").replace(/^www\./, "").split(/[?#]/)[0];
    var m = v.match(/^github\.com\/([^\/\s]+)\/([^\/\s]+)/) || v.match(/^([^\/\s.]+)\/([^\/\s]+)$/);
    if (!m) return null;
    return m[1] + "/" + m[2].replace(/\.git$/, "");
  }
  function ul(a){ return "<ul>" + a.map(function(x){ return "<li>" + esc(x) + "</li>"; }).join("") + "</ul>"; }
  function card(t){
    return '<div class="verdict"><p class="vlab">깔아 본 기록 있음 · ' + esc(t.d) + '</p>' +
      '<h3>' + esc(t.n) + ' <span class="lvbig">' + esc(t.lv) + '</span></h3>' +
      '<p class="src">' + esc(t.what) + ' · github.com/' + esc(t.r) + '</p>' +
      '<p><b>난이도 이유</b><br>' + esc(t.why) + '</p>' +
      '<p><b>준비물</b></p>' + ul(t.need) +
      '<p><b>깔면서 막힌 곳 · 함정</b></p>' + ul(t.trap) +
      '<p><b>지금 쓰나</b> ' + esc(t.use) + '</p>' +
      (t.g ? '<p><a href="../../guide/' + t.g + '/">자세한 기록 읽기 →</a></p>' : '<p class="src">자세한 글은 아직 없습니다.</p>') +
      '</div>';
  }
  function unknown(k){
    return '<div class="verdict none"><p class="vlab">아직 안 깔아 봄</p>' +
      '<h3>' + esc(k) + '</h3>' +
      '<p>이 도구는 아직 직접 깔아 보지 않아서 난이도를 판정하지 않습니다. 대신 깔기 전에 이 3가지를 먼저 확인해 보세요.</p>' +
      '<ol class="steps">' +
      '<li><b>어떻게 까는지</b> — 깃허브 첫 화면 설명(README)에서 「Install」 칸을 찾아 보세요. 앱 내려받기면 비교적 쉽고, 터미널 명령이면 클로드 코드 같은 클로드가 필요합니다. 먼저 깔아야 하는 프로그램이 적혀 있는지도 봅니다.</li>' +
      '<li><b>돈·로그인이 필요한지</b> — 무료 도구라도 일부 기능은 유료 키나 계정 연결이 있어야 움직일 수 있습니다. 써 본 도구 중에도 유료 키 없이는 안 되는 기능, 계정 제한 위험 때문에 켜지 않은 로그인 기능이 있었습니다.</li>' +
      '<li><b>내 컴퓨터에서 무엇을 바꾸는지</b> — 컴퓨터 전체 설정 파일을 고치는지, 저절로 새 버전을 확인하거나 밖으로 보내는 기능이 있는지 클로드에게 「깔기 전에 안을 먼저 확인해 줘」라고 물어보세요. 라이선스(License)도 같이 확인합니다.</li>' +
      '</ol></div>';
  }
  $("rows").innerHTML = T.map(function(t){
    return '<tr><td><b>' + esc(t.n) + '</b><span class="repo">github.com/' + esc(t.r) + '</span></td><td class="lv">' + esc(t.lv) +
      '</td><td>' + esc(t.d) + ' · ' + esc(t.use) + '</td></tr>';
  }).join("");
  $("chk").addEventListener("submit", function(e){
    e.preventDefault();
    var v = $("url").value, k = key(v);
    if (!v.trim()) { $("out").innerHTML = '<p class="notice">깃허브 주소를 넣어 주세요.</p>'; return; }
    if (!k) { $("out").innerHTML = '<p class="notice">깃허브 도구 주소가 아닌 것 같아요. 「github.com/만든사람/도구이름」 모양으로 넣어 주세요.</p>'; return; }
    var hit = T.filter(function(t){ return t.r.toLowerCase() === k; })[0];
    $("out").innerHTML = hit ? card(hit) : unknown("github.com/" + k);
  });
  // 주소 뒤 ?u=만든사람/도구이름 으로 열면 바로 판정 (릴스·글에서 링크로 보낼 때)
  try { var q = new URLSearchParams(location.search).get("u"); if (q) { $("url").value = q; $("chk").requestSubmit ? $("chk").requestSubmit() : $("chk").dispatchEvent(new Event("submit")); } } catch (e) {}
})();
</script>
